  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-shift-enter": "editor::NewlineAbove",
      "ctrl-enter": "editor::NewlineBelow"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-g": "git_panel::Toggle"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-k ctrl-shift-w": [
        "pane::CloseOtherItems",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-alt-shift-t": [
        "pane::CloseOtherItems",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-k ctrl-w": [
        "pane::CloseAllItems",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-k w": [
        "pane::CloseAllItems",
        {
          "close_pinned": false
        }
      ]
    }
  }
]
